{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atelier",
  "version": "0.4.1",
  "identifier": "com.atelier.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Atelier",
        "width": 1100,
        "height": 720,
        "dragDropEnabled": false,
        "decorations": false,
        "backgroundColor": "#0a1220"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' blob: data: http: https:",
        "font-src": "'self' data:",
        "media-src": "'self' blob: data:",
        "worker-src": "'self' blob:",
        "frame-src": "'self' asset: http://asset.localhost https://asset.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "connect-src": "ipc: http://ipc.localhost 'self' blob: https://cdn.jsdelivr.net https://tessdata.projectnaptha.com"
      },
      "devCsp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' blob: data: ws: wss: http: https: ipc:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
